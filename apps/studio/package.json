{
  "name": "@oto/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "dev": "npm run prepare:demo && node scripts/dev.mjs",
    "build": "npm run prepare:demo && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "render:demo": "npm run prepare:demo && remotion render src/remotion/entry.ts OTO-Demo out/oto-demo.mp4 --codec h264",
    "audit": "npm audit --audit-level=high",
    "build:pages": "npm run prepare:demo && tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "@remotion/player": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/web-renderer": "4.0.539"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.539",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
